<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> &middot; CMS KKN</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/png" href="/img/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetV %>">
</head>
<body class="admin">
<%
  var menu = [
    { href: '/admin', key: 'dashboard', label: 'Dasbor', icon: '▤' },
    { href: '/admin/anggota', key: 'anggota', label: 'Anggota', icon: '☺' },
    { href: '/admin/program', key: 'program', label: 'Program Kerja', icon: '✦' },
    { href: '/admin/agenda', key: 'agenda', label: 'Agenda & Kalender', icon: '▦' },
    { href: '/admin/dokumentasi', key: 'dokumentasi', label: 'Dokumentasi', icon: '▣' },
    { href: '/admin/konten', key: 'konten', label: 'Konten Halaman', icon: '✎' },
    { href: '/admin/akun', key: 'akun', label: 'Akun', icon: '⚙' }
  ];
%>
  <aside class="admin-sidebar" id="adminSidebar">
    <a class="admin-brand" href="/admin">
      <img src="/img/logo.png" alt="Logo KKN">
      <span><strong>CMS KKN</strong><small>Dongkelan Asoy</small></span>
    </a>
    <nav class="admin-nav" aria-label="Navigasi CMS">
      <% menu.forEach(function (m) { %>
        <a href="<%= m.href %>" class="<%= nav === m.key ? 'is-active' : '' %>">
          <span class="admin-nav-icon" aria-hidden="true"><%= m.icon %></span><%= m.label %>
        </a>
      <% }); %>
    </nav>
    <div class="admin-sidebar-foot">
      <a href="/" target="_blank" rel="noopener" class="admin-nav"><span class="admin-nav-icon" aria-hidden="true">↗</span>Lihat Website</a>
      <form action="/admin/logout" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="admin-nav admin-logout"><span class="admin-nav-icon" aria-hidden="true">⎋</span>Keluar</button>
      </form>
    </div>
  </aside>

  <div class="admin-main">
    <header class="admin-topbar">
      <button class="admin-burger" id="adminBurger" aria-label="Buka menu" aria-expanded="false">☰</button>
      <div class="admin-topbar-title">
        <h1><%= title %></h1>
        <span class="admin-user">Masuk sebagai <strong><%= user ? user.name : 'Administrator' %></strong></span>
      </div>
    </header>

    <main class="admin-content">
      <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="alert alert-<%= flash.type === 'error' ? 'error' : 'success' %>" role="status"><%= flash.message %></div>
      <% } %>
