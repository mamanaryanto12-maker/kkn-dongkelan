<%- include('partials/head', { title, nav, user, flash, csrfToken, currentPath }) %>

<section class="admin-section">
  <div class="panel">
    <div class="panel-head"><h2>Pengaturan Akun</h2></div>
    <p class="muted panel-intro">Ubah nama tampilan dan kata sandi akun administrator Anda.</p>
    <form action="/admin/akun" method="post" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label class="field span-2"><span>Nama Tampilan</span><input type="text" name="name" value="<%= user ? user.name : '' %>"></label>
      <label class="field span-2"><span>Nama Pengguna</span><input type="text" value="<%= user ? user.username : '' %>" disabled></label>
      <label class="field"><span>Kata Sandi Lama *</span><input type="password" name="password_lama" autocomplete="current-password" required></label>
      <div class="field"></div>
      <label class="field"><span>Kata Sandi Baru *</span><input type="password" name="password_baru" autocomplete="new-password" minlength="8" required><small class="muted">Minimal 8 karakter.</small></label>
      <label class="field"><span>Konfirmasi Kata Sandi Baru *</span><input type="password" name="password_konfirmasi" autocomplete="new-password" minlength="8" required></label>

      <div class="form-actions span-2">
        <button class="btn btn-solid" type="submit">Perbarui Akun</button>
      </div>
    </form>
  </div>
</section>

<%- include('partials/foot') %>
