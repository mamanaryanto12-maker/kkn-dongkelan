  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid footer-grid-3">
      <div class="footer-brand">
        <div class="footer-brand-row">
          <img src="<%= settings.logo || '/img/logo-kkn.png' %>" alt="Logo KKN Dongkelan Nalarasa" onerror="this.style.display='none'">
          <div>
            <strong>KKN Dongkelan Nalarasa</strong>
            <p><%= settings.universitas %></p>
          </div>
        </div>
        <p class="footer-desc"><%= settings.footer_text %></p>
      </div>

      <nav class="footer-col" aria-label="Tautan situs">
        <h4>Jelajahi</h4>
        <ul>
          <li><a href="/">Beranda</a></li>
          <li><a href="/profil">Profil</a></li>
          <li><a href="/anggota">Anggota</a></li>
          <li><a href="/program">Program Kerja</a></li>
          <li><a href="/dokumentasi">Dokumentasi</a></li>
          <li><a href="/kontak">Kontak</a></li>
        </ul>
      </nav>

      <div class="footer-col">
        <h4>Kontak</h4>
        <ul class="footer-contact">
          <% if (settings.lokasi) { %><li><span>Alamat</span><p><%= settings.lokasi %></p></li><% } %>
          <% if (settings.kontak_email || settings.email) { %><li><span>Email</span><a href="mailto:<%= settings.kontak_email || settings.email %>"><%= settings.kontak_email || settings.email %></a></li><% } %>
          <% if (settings.kontak_whatsapp) { %><li><span>WhatsApp</span><a href="https://wa.me/<%= settings.kontak_whatsapp.toString().replace(/\D/g,'') %>" target="_blank" rel="noopener"><%= settings.kontak_whatsapp %></a></li><% } else { %><li><span>WhatsApp</span><span class="muted">(belum diisi)</span></li><% } %>
          <% if (settings.kontak_instagram) { %><li><span>Instagram</span><a href="https://instagram.com/<%= settings.kontak_instagram %>" target="_blank" rel="noopener">@<%= settings.kontak_instagram %></a></li><% } %>
        </ul>
      </div>
    </div>
    <div class="wrap footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> KKN Dongkelan Nalarasa. <%= settings.footer_text %></p>
      <a href="#konten-utama">Kembali ke atas</a>
    </div>
  </footer>

  <button class="to-top" id="toTop" type="button" aria-label="Kembali ke atas">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 5l-7 7 1.4 1.4L11 8.8V19h2V8.8l4.6 4.6L19 12z" fill="currentColor"/></svg>
  </button>

  <script src="/js/main.js?v=<%= assetV %>" defer></script>
</body>
</html>
