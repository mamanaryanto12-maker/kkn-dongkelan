<%- include('../partials/header', { title, settings, nav, currentPath }) %>

<section class="section member-detail-wrap">
  <div class="wrap">
    <a class="text-link back-link" href="/anggota">&larr; Kembali ke daftar anggota</a>
    <div class="member-detail">
      <div class="member-detail-photo reveal">
        <%- include('../partials/avatar', { person: member, klass: 'member-photo-lg' }) %>
      </div>
      <div class="member-detail-body reveal">
        <span class="member-role"><%= member.jabatan || 'Anggota' %></span>
        <h1><%= member.name %></h1>
        <dl class="fact-list">
          <% if (member.nim) { %><div><dt>NIM</dt><dd><%= member.nim %></dd></div><% } %>
          <% if (member.prodi) { %><div><dt>Program Studi</dt><dd><%= member.prodi %></dd></div><% } %>
          <% if (member.fakultas) { %><div><dt>Fakultas</dt><dd><%= member.fakultas %></dd></div><% } %>
          <div><dt>Peran</dt><dd><%= member.jabatan || 'Anggota' %></dd></div>
          <div><dt>Kelompok</dt><dd><%= settings.site_name %></dd></div>
        </dl>
        <% if (member.bio) { %>
          <h2>Biodata Singkat</h2>
          <% member.bio.split('\n').filter(function (l) { return l.trim(); }).forEach(function (p) { %><p><%= p %></p><% }); %>
        <% } %>
        <% if (member.instagram) { %>
          <a class="btn btn-outline" href="https://instagram.com/<%= member.instagram %>" target="_blank" rel="noopener">Instagram @<%= member.instagram %></a>
        <% } %>
      </div>
    </div>

    <% if (others && others.length) { %>
      <h2 class="others-title">Anggota Lainnya</h2>
      <div class="member-grid compact">
        <% others.forEach(function (o) { %>
          <article class="member-card reveal">
            <a class="member-photo-link" href="/anggota/<%= o.id %>">
              <%- include('../partials/avatar', { person: o, klass: 'member-photo' }) %>
            </a>
            <div class="member-body">
              <span class="member-role"><%= o.jabatan || 'Anggota' %></span>
              <h3><a href="/anggota/<%= o.id %>"><%= o.name %></a></h3>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer', { settings }) %>
