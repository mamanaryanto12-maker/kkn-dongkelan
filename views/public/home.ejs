<%- include('../partials/header', { title, settings, nav, currentPath }) %>

<section class="hero hero-banner">
  <div class="hero-slider" data-hero-slider>
    <div class="hero-slider-track" data-hero-track>
      <article class="hero-slide is-active">
        <img class="hero-bg-img" src="/img/foto-bersama.jpg" alt="" aria-hidden="true" loading="eager">
        <div class="hero-overlay"></div>
      </article>
      <% if (galeriSorotan && galeriSorotan[0]) { %>
        <article class="hero-slide">
          <img class="hero-bg-img" src="<%= galeriSorotan[0].file %>" alt="" aria-hidden="true" loading="lazy">
          <div class="hero-overlay"></div>
        </article>
      <% } %>
      <% if (galeriSorotan && galeriSorotan[1]) { %>
        <article class="hero-slide">
          <img class="hero-bg-img" src="<%= galeriSorotan[1].file %>" alt="" aria-hidden="true" loading="lazy">
          <div class="hero-overlay"></div>
        </article>
      <% } %>
    </div>
    <div class="hero-content-layer">
      <div class="wrap hero-inner">
        <div class="hero-content">
          <h1 class="hero-title">Menumbuhkan Dusun Dongkelan Bersama Warga</h1>
          <p class="hero-desc">KKN Dongkelan Nalarasa Universitas Negeri Yogyakarta hadir dengan semangat pengabdian berbasis kebutuhan warga melalui program kerja terarah dan berkelanjutan.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/program">Jelajahi Program Kerja</a>
            <a class="btn btn-ghost-light" href="/dokumentasi">Lihat Dokumentasi</a>
          </div>
          <div class="hero-info">
            <div class="hero-info-item"><span>Lokasi</span><strong>Padukuhan Dongkelan, Desa Sidorejo</strong></div>
            <div class="hero-info-item"><span>Periode</span><strong>12 Oktober - 14 Desember 2026</strong></div>
            <div class="hero-info-item"><span>Perguruan Tinggi</span><strong>Universitas Negeri Yogyakarta</strong></div>
          </div>
        </div>
      </div>
    </div>
    <button class="hero-nav hero-prev" data-hero-prev aria-label="Slide sebelumnya">‹</button>
    <button class="hero-nav hero-next" data-hero-next aria-label="Slide berikutnya">›</button>
    <div class="hero-dots" data-hero-dots></div>
  </div>
</section>

<section class="info-bar">
  <div class="wrap info-bar-grid">
    <article class="info-card-mini">
      <span class="info-label">Lokasi</span>
      <strong class="info-value"><%= settings.lokasi_singkat %></strong>
    </article>
    <article class="info-card-mini">
      <span class="info-label">Periode</span>
      <strong class="info-value">12 Oktober - 14 Desember 2026</strong>
    </article>
    <article class="info-card-mini">
      <span class="info-label">Perguruan Tinggi</span>
      <strong class="info-value"><%= settings.universitas %></strong>
    </article>
  </div>
</section>

<section class="stats-bar">
  <div class="wrap">
    <div class="stats-row">
      <article class="stats-card">
        <span class="stats-num" data-count="<%= totalProgram %>"><%= totalProgram %></span>
        <span class="stats-label">Program Kerja</span>
      </article>
      <article class="stats-card">
        <span class="stats-num" data-count="<%= totalAgenda %>"><%= totalAgenda %></span>
        <span class="stats-label">Agenda</span>
      </article>
      <article class="stats-card">
        <span class="stats-num" data-count="<%= totalAnggota %>"><%= totalAnggota %></span>
        <span class="stats-label">Anggota</span>
      </article>
      <article class="stats-card">
        <span class="stats-num" data-count="2">2</span>
        <span class="stats-label">Rumpun</span>
      </article>
    </div>
  </div>
</section>

<section class="stat-strip">
  <div class="wrap stat-grid">
    <div class="stat"><span class="stat-num" data-count="<%= totalProgram %>"><%= totalProgram %></span><span class="stat-label">Program Kerja</span></div>
    <div class="stat"><span class="stat-num" data-count="<%= totalAgenda %>"><%= totalAgenda %></span><span class="stat-label">Agenda Kegiatan</span></div>
    <div class="stat"><span class="stat-num" data-count="<%= totalAnggota %>"><%= totalAnggota %></span><span class="stat-label">Anggota Kelompok</span></div>
    <div class="stat"><span class="stat-num" data-count="2">2</span><span class="stat-label">Rumpun Program</span></div>
  </div>
</section>



<section class="section section-rumpun">
  <div class="wrap section-head reveal">
    <div>
      <p class="eyebrow">Sekilas Kegiatan</p>
      <h2>Pengabdian yang tumbuh dari kebutuhan warga</h2>
    </div>
    <p class="lede">Program KKN disusun bersama masyarakat melalui observasi dan musyawarah, mencakup bidang pendidikan, lingkungan, kesehatan, ekonomi, hingga teknologi informasi.</p>
  </div>
  <div class="wrap accordion accordion-clean" id="rumpunAccordion">
    <article class="accordion-item reveal is-open">
      <button class="accordion-header" aria-expanded="true" aria-controls="acc-1">
        <span class="accordion-num">01</span>
        <span class="accordion-title">Pendidikan &amp; Keagamaan</span>
        <span class="accordion-icon" aria-hidden="true">+</span>
      </button>
      <div class="accordion-panel" id="acc-1">
        <div class="accordion-body">
          <p>Pendampingan belajar, TPA, pengenalan sejarah, dan literasi digital bagi anak serta warga Dusun Dongkelan.</p>
          <ul class="check-list">
            <li>Pendampingan belajar di posko dan rumah warga</li>
            <li>Kegiatan TPA dan pembinaan keagamaan</li>
            <li>Literasi digital dan pengenalan sejarah lokal</li>
          </ul>
        </div>
      </div>
    </article>
    <article class="accordion-item reveal">
      <button class="accordion-header" aria-expanded="false" aria-controls="acc-2">
        <span class="accordion-num">02</span>
        <span class="accordion-title">Lingkungan &amp; Kesehatan</span>
        <span class="accordion-icon" aria-hidden="true">+</span>
      </button>
      <div class="accordion-panel" id="acc-2" hidden>
        <div class="accordion-body">
          <p>Pengelolaan sampah, biopori, TOGA, senam bersama, dan edukasi kesehatan bagi warga.</p>
          <ul class="check-list">
            <li>Pengelolaan sampah dan pembuatan biopori</li>
            <li>Penanaman dan pemanfaatan TOGA</li>
            <li>Senam bersama dan edukasi kesehatan</li>
          </ul>
        </div>
      </div>
    </article>
    <article class="accordion-item reveal">
      <button class="accordion-header" aria-expanded="false" aria-controls="acc-3">
        <span class="accordion-num">03</span>
        <span class="accordion-title">Ekonomi &amp; Teknologi</span>
        <span class="accordion-icon" aria-hidden="true">+</span>
      </button>
      <div class="accordion-panel" id="acc-3" hidden>
        <div class="accordion-body">
          <p>Digitalisasi UMKM, pemetaan padukuhan, serta penerapan teknologi sederhana untuk mendukung kemandirian warga.</p>
          <ul class="check-list">
            <li>Digitalisasi dan pendampingan UMKM</li>
            <li>Pemetaan padukuhan berbasis kebutuhan</li>
            <li>Penerapan teknologi sederhana untuk warga</li>
          </ul>
        </div>
      </div>
    </article>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap section-head reveal section-head-row">
    <div>
      <p class="eyebrow">Program Kerja</p>
      <h2>Program kerja pilihan</h2>
      <p class="lede">Sebagian program yang menjadi perhatian kelompok dalam pelaksanaan KKN Dongkelan Nalarasa.</p>
    </div>
    <a class="btn btn-outline" href="/program">Lihat seluruh program kerja</a>
  </div>
  <div class="wrap program-grid program-grid-eq">
    <% programHighlights.forEach(function (p) { %>
      <article class="program-card reveal">
        <div class="program-card-top">
          <span class="badge badge-cat"><%= p.kategori %></span>
          <span class="badge badge-status badge-<%= statusMeta(p.status).key %>"><%= statusMeta(p.status).label %></span>
        </div>
        <div class="program-card-body">
          <h3><%= p.nama %></h3>
          <p class="program-desc"><%= p.deskripsi.length > 140 ? p.deskripsi.substring(0,137) + '...' : p.deskripsi %></p>
        </div>
        <div class="program-card-meta">
          <% if (p.sasaran) { %>
            <div class="meta-item">
              <span class="meta-label">Sasaran</span>
              <span class="meta-value"><%= p.sasaran %></span>
            </div>
          <% } %>
          <% if (p.lokasi) { %>
            <div class="meta-item">
              <span class="meta-label">Lokasi</span>
              <span class="meta-value"><%= p.lokasi %></span>
            </div>
          <% } %>
        </div>
      </article>
    <% }); %>
  </div>
</section>

<section class="section section-agenda">
  <div class="wrap section-head reveal">
    <div>
      <p class="eyebrow">Agenda Kegiatan</p>
      <h2>Agenda kegiatan kelompok</h2>
      <p class="lede">Rangkaian agenda kegiatan KKN Dongkelan Nalarasa.</p>
      <p class="muted">Jadwal rinci hanya untuk internal anggota kelompok.</p>
    </div>
  </div>
  <div class="wrap">
    <div class="timeline">
      <% if (upcoming.length === 0) { %>
        <div class="empty-state">Belum ada agenda kegiatan.</div>
      <% } else { %>
        <% upcoming.forEach(function (a) { %>
          <article class="timeline-item reveal">
            <div class="timeline-marker">
              <span class="timeline-dot"></span>
            </div>
            <div class="timeline-card">
              <div class="timeline-card-head">
                <span class="timeline-chip"><%= a.tanggal_mulai ? formatTanggal(a.tanggal_mulai) : '-' %><% if (a.jam_mulai) { %> • <%= a.jam_mulai %><% if (a.jam_selesai) { %> - <%= a.jam_selesai %><% } %><% } %></span>
                <span class="timeline-badge timeline-<%= ((statusMeta(a.status).key)||'rencana') %>"><%= statusMeta(a.status).label %></span>
              </div>
              <h3><%= a.judul %></h3>
              <% if (a.kategori) { %><p class="timeline-desc"><%= a.kategori %></p><% } %>
              <div class="timeline-meta">
                <span class="timeline-icon">📍</span>
                <span><%= a.lokasi || '-' %></span>
                <span class="timeline-type">Program Kelompok</span>
              </div>
            </div>
          </article>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>

<section class="section section-lokasi">
  <div class="wrap lokasi-grid">
    <div class="reveal">
      <p class="eyebrow">Lokasi Pengabdian</p>
      <h2><%= settings.lokasi_singkat %></h2>
      <p class="lede"><%= settings.lokasi %></p>
      <div class="location-actions">
        <a class="btn btn-primary" href="https://maps.google.com/?q=<%= encodeURIComponent(settings.maps_query) %>" target="_blank" rel="noopener">Buka di Google Maps</a>
      </div>
    </div>
    <div class="reveal lokasi-map">
      <div class="map-frame">
        <iframe title="Peta lokasi KKN" src="https://maps.google.com/maps?q=<%= encodeURIComponent(settings.maps_query) %>&z=14&output=embed"
          loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>

<section class="section section-jejak">
  <div class="wrap">
    <div class="section-head reveal section-head-row">
      <div>
        <p class="eyebrow">Dokumentasi</p>
        <h2>Jejak Kegiatan</h2>
        <p class="lede">Kumpulan foto dan dokumen kegiatan KKN <%= settings.site_short %>.</p>
      </div>
      <a class="btn btn-outline" href="/dokumentasi">Lihat semua dokumentasi</a>
    </div>
    <% if (typeof artikelList !== 'undefined' && artikelList.length) { %>
      <div class="artikel-featured reveal">
        <div class="artikel-featured-media">
          <img src="<%= artikelList[0].sampul %>" alt="<%= artikelList[0].judul %>" loading="lazy">
        </div>
        <div class="artikel-featured-body">
          <div class="artikel-meta">
            <span class="artikel-badge"><%= artikelList[0].kategori %></span>
            <span class="artikel-date"><%= artikelList[0].tanggal %></span>
            <span class="artikel-loc"><%= artikelList[0].lokasi %></span>
          </div>
          <h3><%= artikelList[0].judul %></h3>
          <p><%= artikelList[0].kutipan %></p>
          <a class="text-link" href="/dokumentasi/<%= artikelList[0].slug %>">Baca selengkapnya →</a>
        </div>
      </div>
    <% } %>
    <div class="artikel-grid reveal">
      <% if (typeof artikelList !== 'undefined' && artikelList.length > 1) { %>
        <% artikelList.slice(1).forEach(function (a) { %>
          <article class="artikel-card">
            <div class="artikel-card-media">
              <img src="<%= a.sampul %>" alt="<%= a.judul %>" loading="lazy">
            </div>
            <div class="artikel-card-body">
              <div class="artikel-meta">
                <span class="artikel-badge"><%= a.kategori %></span>
                <span class="artikel-date"><%= a.tanggal %></span>
              </div>
              <h3><%= a.judul %></h3>
              <p><%= a.kutipan.length > 90 ? a.kutipan.substring(0,87) + '...' : a.kutipan %></p>
              <a class="text-link" href="/dokumentasi/<%= a.slug %>">Baca selengkapnya →</a>
            </div>
          </article>
        <% }); %>
      <% } %>
      <% if (typeof artikelList === 'undefined' || artikelList.length === 0) { %>
        <% galeri.forEach(function (g) { %>
          <article class="artikel-card">
            <div class="artikel-card-media">
              <img src="<%= g.file %>" alt="<%= g.judul %>" loading="lazy">
            </div>
            <div class="artikel-card-body">
              <h3><%= g.judul %></h3>
              <a class="text-link" href="/dokumentasi">Lihat dokumentasi →</a>
            </div>
          </article>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer', { settings }) %>
