<%- include('../partials/header', { title, settings, nav, currentPath }) %>

<section class="hero hero-full">
  <div class="hero-slider hero-slider-full" data-hero-slider>
    <div class="hero-slider-track" data-hero-track>
      <article class="hero-slide is-active">
        <img src="/img/foto-bersama.jpg" alt="Foto bersama kelompok KKN Dongkelan Nalarasa">
        <div class="hero-overlay"></div>
        <div class="wrap hero-slide-inner">
          <div class="hero-content">
            <h1 class="hero-title">Menumbuhkan Dusun Dongkelan Bersama Warga</h1>
            <p class="hero-desc">KKN Dongkelan Nalarasa Universitas Negeri Yogyakarta hadir dengan semangat pengabdian berbasis kebutuhan warga melalui program kerja terarah dan berkelanjutan.</p>
            <div class="hero-actions">
              <a class="btn btn-solid" href="/program">Jelajahi Program Kerja</a>
              <a class="btn btn-outline btn-light" href="/dokumentasi">Lihat Dokumentasi</a>
            </div>
          </div>
        </div>
      </article>
      <% if (galeriSorotan && galeriSorotan[0]) { %>
        <article class="hero-slide">
          <img src="<%= galeriSorotan[0].file %>" alt="<%= galeriSorotan[0].judul %>" loading="lazy">
          <div class="hero-overlay"></div>
          <div class="wrap hero-slide-inner">
            <div class="hero-content">
              <h1 class="hero-title">Sorotan Program Kerja</h1>
              <p class="hero-desc"><%= galeriSorotan[0].keterangan || 'Berbagai program nyata untuk mendukung pemberdayaan masyarakat Dusun Dongkelan.' %></p>
              <div class="hero-actions">
                <a class="btn btn-solid" href="/program">Jelajahi Program Kerja</a>
                <a class="btn btn-outline btn-light" href="/dokumentasi">Lihat Dokumentasi</a>
              </div>
            </div>
          </div>
        </article>
      <% } %>
      <% if (galeriSorotan && galeriSorotan[1]) { %>
        <article class="hero-slide">
          <img src="<%= galeriSorotan[1].file %>" alt="<%= galeriSorotan[1].judul %>" loading="lazy">
          <div class="hero-overlay"></div>
          <div class="wrap hero-slide-inner">
            <div class="hero-content">
              <h1 class="hero-title">Jejak Pengabdian Bersama Warga</h1>
              <p class="hero-desc"><%= galeriSorotan[1].keterangan || 'Sinergi dan kebersamaan dalam setiap langkah pengabdian di Dusun Dongkelan.' %></p>
              <div class="hero-actions">
                <a class="btn btn-solid" href="/program">Jelajahi Program Kerja</a>
                <a class="btn btn-outline btn-light" href="/dokumentasi">Lihat Dokumentasi</a>
              </div>
            </div>
          </div>
        </article>
      <% } %>
    </div>
    <button class="hero-nav hero-nav-prev" data-hero-prev aria-label="Slide sebelumnya">‹</button>
    <button class="hero-nav hero-nav-next" data-hero-next aria-label="Slide berikutnya">›</button>
    <div class="hero-dots hero-dots-center" data-hero-dots></div>
  </div>
</section>

<section class="info-bar">
  <div class="wrap info-bar-grid">
    <article class="info-card-mini">
      <span class="info-label">Lokasi</span>
      <strong class="info-value"><%= settings.lokasi_singkat %></strong>
    </article>
    <article class="info-card-mini">
      <span class="info-label">Periode</span>
      <strong class="info-value">12 Oktober - 14 Desember 2026</strong>
    </article>
    <article class="info-card-mini">
      <span class="info-label">Perguruan Tinggi</span>
      <strong class="info-value"><%= settings.universitas %></strong>
    </article>
  </div>
</section>

<section class="stats-bar">
  <div class="wrap stats-grid">
    <div class="stat-item"><span class="stat-num-big" data-count="<%= totalProgram %>"><%= totalProgram %></span><span class="stat-label-sm">Program Kerja</span></div>
    <div class="stat-item"><span class="stat-num-big" data-count="<%= totalAgenda %>"><%= totalAgenda %></span><span class="stat-label-sm">Agenda</span></div>
    <div class="stat-item"><span class="stat-num-big" data-count="<%= totalAnggota %>"><%= totalAnggota %></span><span class="stat-label-sm">Anggota</span></div>
    <div class="stat-item"><span class="stat-num-big" data-count="2">2</span><span class="stat-label-sm">Rumpun</span></div>
  </div>
</section>

<section class="stat-strip">
  <div class="wrap stat-grid">
    <div class="stat"><span class="stat-num" data-count="<%= totalProgram %>"><%= totalProgram %></span><span class="stat-label">Program Kerja</span></div>
    <div class="stat"><span class="stat-num" data-count="<%= totalAgenda %>"><%= totalAgenda %></span><span class="stat-label">Agenda Kegiatan</span></div>
    <div class="stat"><span class="stat-num" data-count="<%= totalAnggota %>"><%= totalAnggota %></span><span class="stat-label">Anggota Kelompok</span></div>
    <div class="stat"><span class="stat-num" data-count="2">2</span><span class="stat-label">Rumpun Program</span></div>
  </div>
</section>



<section class="section">
  <div class="wrap section-head reveal">
    <div>
      <p class="eyebrow">Sekilas Kegiatan</p>
      <h2>Pengabdian yang tumbuh dari kebutuhan warga</h2>
    </div>
    <p class="lede">Program KKN disusun bersama masyarakat melalui observasi dan musyawarah, mencakup bidang pendidikan, lingkungan, kesehatan, ekonomi, hingga teknologi informasi.</p>
  </div>
  <div class="wrap accordion" id="rumpunAccordion">
    <article class="accordion-item reveal is-open">
      <button class="accordion-header" aria-expanded="true" aria-controls="acc-1">
        <span class="accordion-num">01</span>
        <span class="accordion-title">Pendidikan &amp; Keagamaan</span>
        <span class="accordion-icon" aria-hidden="true">+</span>
      </button>
      <div class="accordion-panel" id="acc-1">
        <div class="accordion-body">
          <p>Pendampingan belajar, TPA, pengenalan sejarah, dan literasi digital bagi anak serta warga Dusun Dongkelan.</p>
          <ul class="list-check">
            <li>Pendampingan belajar di posko dan rumah warga</li>
            <li>Kegiatan TPA dan pembinaan keagamaan</li>
            <li>Literasi digital dan pengenalan sejarah lokal</li>
          </ul>
        </div>
      </div>
    </article>
    <article class="accordion-item reveal">
      <button class="accordion-header" aria-expanded="false" aria-controls="acc-2">
        <span class="accordion-num">02</span>
        <span class="accordion-title">Lingkungan &amp; Kesehatan</span>
        <span class="accordion-icon" aria-hidden="true">+</span>
      </button>
      <div class="accordion-panel" id="acc-2" hidden>
        <div class="accordion-body">
          <p>Upaya menjaga kebersihan lingkungan, pelestarian, serta peningkatan kesadaran kesehatan warga.</p>
          <ul class="list-check">
            <li>Pengelolaan sampah dan edukasi bank sampah</li>
            <li>Biopori dan penghijauan</li>
            <li>TOGA, senam bersama, dan edukasi kesehatan</li>
          </ul>
        </div>
      </div>
    </article>
    <article class="accordion-item reveal">
      <button class="accordion-header" aria-expanded="false" aria-controls="acc-3">
        <span class="accordion-num">03</span>
        <span class="accordion-title">Ekonomi &amp; Teknologi</span>
        <span class="accordion-icon" aria-hidden="true">+</span>
      </button>
      <div class="accordion-panel" id="acc-3" hidden>
        <div class="accordion-body">
          <p>Pemberdayaan ekonomi masyarakat dan pemanfaatan teknologi sederhana untuk mendukung kemandirian desa.</p>
          <ul class="list-check">
            <li>Digitalisasi UMKM dan promosi produk lokal</li>
            <li>Pemetaan padukuhan berbasis informasi</li>
            <li>Pemasangan lampu jalan otomatis dan inovasi sederhana</li>
          </ul>
        </div>
      </div>
    </article>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap section-head reveal">
    <p class="eyebrow">Sorotan</p>
    <h2>Program kerja pilihan</h2>
    <p class="lede">Sebagian program yang menjadi perhatian kelompok dalam pelaksanaan KKN.</p>
  </div>
  <div class="wrap program-grid">
    <% programHighlights.forEach(function (p) { %>
      <article class="program-card reveal">
        <div class="program-meta">
          <span class="chip chip-<%= p.tipe === 'Individu' ? 'individu' : 'kelompok' %>"><%= p.tipe %></span>
          <span class="status status-<%= statusMeta(p.status).key %>"><%= statusMeta(p.status).label %></span>
        </div>
        <h3><%= p.nama %></h3>
        <p class="program-kat"><%= p.kategori %></p>
        <p><%= p.deskripsi %></p>
        <dl class="program-info">
          <% if (p.sasaran) { %><div><dt>Sasaran</dt><dd><%= p.sasaran %></dd></div><% } %>
          <% if (p.lokasi) { %><div><dt>Lokasi</dt><dd><%= p.lokasi %></dd></div><% } %>
        </dl>
      </article>
    <% }); %>
  </div>
  <div class="wrap center"><a class="btn btn-outline" href="/program">Lihat seluruh program kerja &rarr;</a></div>
</section>

<section class="section">
  <div class="wrap two-col">
    <div class="reveal">
      <p class="eyebrow">Agenda Kegiatan</p>
      <h2>Rencana kegiatan kelompok</h2>
      <p class="lede">Rangkaian agenda kegiatan KKN Dongkelan Nalarasa. Jadwal rinci hanya untuk internal anggota kelompok.</p>
      <ul class="agenda-list">
        <% if (upcoming.length === 0) { %>
          <li class="agenda-empty">Belum ada agenda kegiatan.</li>
        <% } %>
        <% upcoming.forEach(function (a) { %>
          <li class="agenda-item">
            <div class="agenda-body">
              <strong><%= a.judul %></strong>
              <span class="agenda-sub"><%= a.kategori || 'Kegiatan' %><% if (a.lokasi) { %> &middot; <%= a.lokasi %><% } %></span>
            </div>
            <span class="status status-<%= statusMeta(a.status).key %>"><%= statusMeta(a.status).label %></span>
          </li>
        <% }); %>
      </ul>
    </div>

    <div class="reveal map-panel">
      <p class="eyebrow">Lokasi Pengabdian</p>
      <h3><%= settings.lokasi_singkat %></h3>
      <p><%= settings.lokasi %></p>
      <div class="map-frame">
        <iframe title="Peta lokasi KKN" src="https://maps.google.com/maps?q=<%= encodeURIComponent(settings.maps_query) %>&z=14&output=embed"
          loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <a class="btn btn-ghost" href="https://maps.google.com/?q=<%= encodeURIComponent(settings.maps_query) %>" target="_blank" rel="noopener">Buka di Google Maps</a>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap gallery-editorial">
    <div class="gallery-editorial-header reveal">
      <div>
        <p class="eyebrow">Dokumentasi</p>
        <h2>Jejak kegiatan</h2>
        <p class="lede">Kumpulan foto dan dokumen kegiatan KKN <%= settings.site_short %>.</p>
      </div>
      <div class="gallery-editorial-nav">
        <button class="gallery-editorial-btn" data-gallery-prev aria-label="Geser sebelumnya">←</button>
        <button class="gallery-editorial-btn" data-gallery-next aria-label="Geser berikutnya">→</button>
      </div>
    </div>
    <div class="gallery-editorial-track-wrap reveal" data-reveal="scale">
      <div class="gallery-editorial-track" data-gallery-track>
        <% galeri.forEach(function (g, idx) { %>
          <article class="gallery-editorial-card">
            <div class="gallery-editorial-media">
              <img src="<%= g.file %>" alt="<%= g.judul %>" loading="lazy">
            </div>
            <div class="gallery-editorial-body">
              <div class="gallery-editorial-meta">
                <% if (g.kegiatan) { %><span class="gallery-editorial-kat"><%= g.kegiatan %></span><% } %>
                <% if (g.tanggal) { %><span class="gallery-editorial-date"><%= formatTanggal(g.tanggal) %></span><% } %>
              </div>
              <h3 class="gallery-editorial-title"><%= g.judul %></h3>
              <% if (g.keterangan) { %><p class="gallery-editorial-excerpt"><%= g.keterangan %></p><% } %>
              <a class="gallery-editorial-link" href="/dokumentasi">Lihat dokumentasi <span>→</span></a>
            </div>
          </article>
        <% }); %>
        <% if (galeri.length === 0) { %>
          <% galeriSorotan.forEach(function (g) { %>
            <article class="gallery-editorial-card">
              <div class="gallery-editorial-media">
                <img src="<%= g.file %>" alt="<%= g.judul %>" loading="lazy">
              </div>
              <div class="gallery-editorial-body">
                <h3 class="gallery-editorial-title"><%= g.judul %></h3>
                <a class="gallery-editorial-link" href="/dokumentasi">Lihat dokumentasi <span>→</span></a>
              </div>
            </article>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer', { settings }) %>
