<%- include('../partials/header', { title, settings, nav, currentPath }) %>

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy reveal">
      <div class="hero-kicker">
        <span class="hero-kicker-dot"></span>
        <span><%= settings.hero_eyebrow || 'KKN Universitas Negeri Yogyakarta' %></span>
      </div>
      <h1 class="hero-title"><%= settings.hero_title %></h1>
      <p class="hero-desc"><%= settings.hero_desc %></p>
      <div class="hero-actions">
        <a class="btn btn-solid" href="/program">Jelajahi Program Kerja</a>
        <a class="btn btn-outline" href="/dokumentasi">Lihat Dokumentasi</a>
      </div>
      <div class="hero-meta">
        <div class="hero-meta-item">
          <span class="hero-meta-label">Lokasi</span>
          <span class="hero-meta-value"><%= settings.lokasi_singkat %></span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">Periode</span>
          <span class="hero-meta-value"><%= settings.periode %></span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">Perguruan Tinggi</span>
          <span class="hero-meta-value"><%= settings.universitas %></span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-media reveal">
    <div class="hero-slider" data-hero-slider>
      <div class="hero-slider-track" data-hero-track>
        <article class="hero-slide is-active">
          <img src="/img/foto-bersama.jpg" alt="Foto bersama kelompok <%= settings.site_name %>">
          <div class="hero-slide-content">
            <span class="hero-slide-kicker">KKN <%= settings.site_short %></span>
            <h3 class="hero-slide-title">Sinergi Nyata untuk Masyarakat</h3>
            <p>Pengabdian berbasis kebutuhan warga, terwujud melalui program kerja yang terukur dan berkelanjutan.</p>
            <div class="hero-actions">
              <a class="btn btn-solid" href="/program">Lihat Program Kerja</a>
              <a class="btn btn-outline" href="/dokumentasi">Jelajahi Dokumentasi</a>
            </div>
          </div>
        </article>
        <% if (galeriSorotan && galeriSorotan[0]) { %>
          <article class="hero-slide">
            <img src="<%= galeriSorotan[0].file %>" alt="<%= galeriSorotan[0].judul %>" loading="lazy">
            <div class="hero-slide-content">
              <span class="hero-slide-kicker">Jejak Pengabdian</span>
              <h3 class="hero-slide-title"><%= galeriSorotan[0].judul %></h3>
              <p><%= galeriSorotan[0].keterangan || 'Kolaborasi dan aksi nyata bersama warga.' %></p>
              <div class="hero-actions">
                <a class="btn btn-solid" href="/dokumentasi">Buka Dokumentasi</a>
              </div>
            </div>
          </article>
        <% } %>
        <% if (galeriSorotan && galeriSorotan[1]) { %>
          <article class="hero-slide">
            <img src="<%= galeriSorotan[1].file %>" alt="<%= galeriSorotan[1].judul %>" loading="lazy">
            <div class="hero-slide-content">
              <span class="hero-slide-kicker">Program Unggulan</span>
              <h3 class="hero-slide-title"><%= galeriSorotan[1].judul %></h3>
              <p><%= galeriSorotan[1].keterangan || 'Solusi terarah untuk permasalahan desa.' %></p>
              <div class="hero-actions">
                <a class="btn btn-solid" href="/program">Lihat Program</a>
              </div>
            </div>
          </article>
        <% } %>
      </div>
      <div class="hero-dots" data-hero-dots></div>
      <div class="hero-slide-nav">
        <button class="hero-nav-btn" data-hero-prev aria-label="Slide sebelumnya">←</button>
        <button class="hero-nav-btn" data-hero-next aria-label="Slide berikutnya">→</button>
      </div>
    </div>
  </div>
</section>

<section class="stat-strip">
  <div class="wrap stat-grid">
    <div class="stat"><span class="stat-num" data-count="<%= totalProgram %>"><%= totalProgram %></span><span class="stat-label">Program Kerja</span></div>
    <div class="stat"><span class="stat-num" data-count="<%= totalAgenda %>"><%= totalAgenda %></span><span class="stat-label">Agenda Kegiatan</span></div>
    <div class="stat"><span class="stat-num" data-count="<%= totalAnggota %>"><%= totalAnggota %></span><span class="stat-label">Anggota Kelompok</span></div>
    <div class="stat"><span class="stat-num" data-count="2">2</span><span class="stat-label">Rumpun Program</span></div>
  </div>
</section>



<section class="section">
  <div class="wrap section-head reveal">
    <div>
      <p class="eyebrow">Sekilas Kegiatan</p>
      <h2>Pengabdian yang tumbuh dari kebutuhan warga</h2>
    </div>
    <p class="lede">Program KKN disusun bersama masyarakat melalui observasi dan musyawarah, mencakup bidang pendidikan, lingkungan, kesehatan, ekonomi, hingga teknologi informasi.</p>
  </div>
  <div class="wrap pillars">
    <article class="pillar reveal" data-reveal="scale">
      <div class="pillar-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 3L4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3z" stroke="currentColor" stroke-width="1.6"/></svg>
      </div>
      <h3>Pendidikan &amp; Keagamaan</h3>
      <p>Pendampingan belajar, TPA, hingga pengenalan sejarah dan literasi digital bagi anak dan warga.</p>
    </article>
    <article class="pillar reveal" data-reveal="scale">
      <div class="pillar-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 21s-6-4.35-6-10a6 6 0 0112 0c0 5.65-6 10-6 10z" stroke="currentColor" stroke-width="1.6"/></svg>
      </div>
      <h3>Lingkungan &amp; Kesehatan</h3>
      <p>Pengelolaan sampah, biopori, TOGA, hingga kegiatan senam dan edukasi kesehatan.</p>
    </article>
    <article class="pillar reveal" data-reveal="scale">
      <div class="pillar-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M4 19V5m0 14h16M8 9h2m4 0h2M8 13h2m4 0h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </div>
      <h3>Ekonomi &amp; Teknologi</h3>
      <p>Digitalisasi UMKM, pemetaan padukuhan, dan pemasangan lampu jalan otomatis.</p>
    </article>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap section-head reveal">
    <p class="eyebrow">Sorotan</p>
    <h2>Program kerja pilihan</h2>
    <p class="lede">Sebagian program yang menjadi perhatian kelompok dalam pelaksanaan KKN.</p>
  </div>
  <div class="wrap program-grid">
    <% programHighlights.forEach(function (p) { %>
      <article class="program-card reveal">
        <div class="program-meta">
          <span class="chip chip-<%= p.tipe === 'Individu' ? 'individu' : 'kelompok' %>"><%= p.tipe %></span>
          <span class="status status-<%= statusMeta(p.status).key %>"><%= statusMeta(p.status).label %></span>
        </div>
        <h3><%= p.nama %></h3>
        <p class="program-kat"><%= p.kategori %></p>
        <p><%= p.deskripsi %></p>
        <dl class="program-info">
          <% if (p.sasaran) { %><div><dt>Sasaran</dt><dd><%= p.sasaran %></dd></div><% } %>
          <% if (p.lokasi) { %><div><dt>Lokasi</dt><dd><%= p.lokasi %></dd></div><% } %>
        </dl>
      </article>
    <% }); %>
  </div>
  <div class="wrap center"><a class="btn btn-outline" href="/program">Lihat seluruh program kerja &rarr;</a></div>
</section>

<section class="section">
  <div class="wrap two-col">
    <div class="reveal">
      <p class="eyebrow">Agenda Kegiatan</p>
      <h2>Rencana kegiatan kelompok</h2>
      <p class="lede">Rangkaian agenda kegiatan KKN Dongkelan Nalarasa. Jadwal rinci hanya untuk internal anggota kelompok.</p>
      <ul class="agenda-list">
        <% if (upcoming.length === 0) { %>
          <li class="agenda-empty">Belum ada agenda kegiatan.</li>
        <% } %>
        <% upcoming.forEach(function (a) { %>
          <li class="agenda-item">
            <div class="agenda-body">
              <strong><%= a.judul %></strong>
              <span class="agenda-sub"><%= a.kategori || 'Kegiatan' %><% if (a.lokasi) { %> &middot; <%= a.lokasi %><% } %></span>
            </div>
            <span class="status status-<%= statusMeta(a.status).key %>"><%= statusMeta(a.status).label %></span>
          </li>
        <% }); %>
      </ul>
    </div>

    <div class="reveal map-panel">
      <p class="eyebrow">Lokasi Pengabdian</p>
      <h3><%= settings.lokasi_singkat %></h3>
      <p><%= settings.lokasi %></p>
      <div class="map-frame">
        <iframe title="Peta lokasi KKN" src="https://maps.google.com/maps?q=<%= encodeURIComponent(settings.maps_query) %>&z=14&output=embed"
          loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <a class="btn btn-ghost" href="https://maps.google.com/?q=<%= encodeURIComponent(settings.maps_query) %>" target="_blank" rel="noopener">Buka di Google Maps</a>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap gallery-editorial">
    <div class="gallery-editorial-header reveal">
      <div>
        <p class="eyebrow">Dokumentasi</p>
        <h2>Jejak kegiatan</h2>
        <p class="lede">Kumpulan foto dan dokumen kegiatan KKN <%= settings.site_short %>.</p>
      </div>
      <div class="gallery-editorial-nav">
        <button class="gallery-editorial-btn" data-gallery-prev aria-label="Geser sebelumnya">←</button>
        <button class="gallery-editorial-btn" data-gallery-next aria-label="Geser berikutnya">→</button>
      </div>
    </div>
    <div class="gallery-editorial-track-wrap reveal" data-reveal="scale">
      <div class="gallery-editorial-track" data-gallery-track>
        <% galeri.forEach(function (g, idx) { %>
          <article class="gallery-editorial-card">
            <div class="gallery-editorial-media">
              <img src="<%= g.file %>" alt="<%= g.judul %>" loading="lazy">
            </div>
            <div class="gallery-editorial-body">
              <div class="gallery-editorial-meta">
                <% if (g.kegiatan) { %><span class="gallery-editorial-kat"><%= g.kegiatan %></span><% } %>
                <% if (g.tanggal) { %><span class="gallery-editorial-date"><%= formatTanggal(g.tanggal) %></span><% } %>
              </div>
              <h3 class="gallery-editorial-title"><%= g.judul %></h3>
              <% if (g.keterangan) { %><p class="gallery-editorial-excerpt"><%= g.keterangan %></p><% } %>
              <a class="gallery-editorial-link" href="/dokumentasi">Lihat dokumentasi <span>→</span></a>
            </div>
          </article>
        <% }); %>
        <% if (galeri.length === 0) { %>
          <% galeriSorotan.forEach(function (g) { %>
            <article class="gallery-editorial-card">
              <div class="gallery-editorial-media">
                <img src="<%= g.file %>" alt="<%= g.judul %>" loading="lazy">
              </div>
              <div class="gallery-editorial-body">
                <h3 class="gallery-editorial-title"><%= g.judul %></h3>
                <a class="gallery-editorial-link" href="/dokumentasi">Lihat dokumentasi <span>→</span></a>
              </div>
            </article>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer', { settings }) %>
