# Konfigurasi Website KKN Dongkelan Asoy
# Salin berkas ini menjadi `.env` lalu sesuaikan nilainya.
# Catatan: proyek ini membaca variabel lingkungan langsung dari proses (tanpa dotenv).
# Jalankan dengan, contoh:  $env:PORT=3000; npm start   (PowerShell)

# Port dan host server
PORT=3000
HOST=0.0.0.0

# Lokasi penyimpanan (kosongkan untuk default: ./data dan ./public/uploads).
# Di host berdisk permanen, arahkan ke mount disk, contoh:
#   DATA_DIR=/var/data
#   UPLOAD_DIR=/var/data/uploads
DATA_DIR=
UPLOAD_DIR=

# Versi aset CSS/JS untuk cache-busting. Kosong = pakai waktu proses mulai.
ASSET_VERSION=

# Kunci rahasia sesi (32+ karakter acak). Bila kosong, dibuat otomatis
# dan disimpan di data/session-secret.txt
SESSION_SECRET=

# Akun administrator awal. Bila ADMIN_PASSWORD kosong, kata sandi acak
# dibuat dan dicetak ke terminal serta disimpan di data/initial-admin.txt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Mode produksi. Saat production, cookie sesi memakai atribut secure.
NODE_ENV=development

# Setel ke 1 bila menjalankan production di balik proxy tanpa HTTPS.
FORCE_HTTP=0

# ---------------------------------------------------------------------------
# (Opsional) Turso — database libSQL/SQLite di cloud.
# Diisi HANYA untuk deployment serverless (Vercel). Bila kosong, aplikasi
# memakai SQLite lokal (node:sqlite) di DATA_DIR.
# Buat database gratis di https://turso.tech lalu ambil URL & token.
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# (Opsional) Cloudinary — penyimpanan gambar di cloud.
# Diisi untuk Vercel (tanpa disk tetap). Bila kosong, gambar disimpan lokal
# di UPLOAD_DIR dan dilayani dari /uploads.
# Buat akun gratis di https://cloudinary.com
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kkn-dongkelan
